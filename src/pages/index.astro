---
import BalanceOfPower from '../components/BalanceOfPower.astro';
import ElectoralTileMap from '../components/ElectoralTileMap.astro';
import NumberAnimationSelector from '../components/NumberAnimationSelector.astro';
import { FRANKLIN_WEIGHTS, franklinFontUrl } from '../config/fonts';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Balance of power</title>
		{
			FRANKLIN_WEIGHTS.map((weight) => (
				<link
					rel="preload"
					as="font"
					type="font/woff2"
					href={franklinFontUrl(weight)}
					crossorigin
				/>
			))
		}
	</head>
	<body>
		<main>
			<div class="demo">
				<NumberAnimationSelector />
				<div class="widget-card">
					<BalanceOfPower />
					<ElectoralTileMap />
				</div>
			</div>
		</main>

		<style>
			body {
				margin: 0;
				background: var(--bop-color-canvas);
			}

			main {
				display: flex;
				justify-content: center;
				padding: 40px 16px;
			}

			.demo {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 12px;
				width: 100%;
			}

			.widget-card {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 0px;
				width: 100%;
				/* The narrower widget and the wider map both center within this on their own —
				   padding is added outside it, not folded in, so it stays even on every side. */
				max-width: var(--bop-map-width);
				padding: var(--bop-card-padding) var(--bop-card-padding) var(--bop-card-padding-bottom);
				border-radius: var(--bop-card-radius);
				background: var(--bop-color-page);
			}
		</style>
	</body>
</html>
