---
import {
	CANDIDATE_NAME,
	CUSTOM_PROPERTY,
	DATA_ATTRIBUTE,
	MAP_ASSIGNMENT_LABEL,
	MAP_GEOMETRY,
	MAP_RIPPLE_MODE,
	MAP_RIPPLE_REACH,
	MAP_RIPPLE_TRIGGER,
	PARTY,
	type MapRippleMode,
	type MapRippleReach,
	type MapRippleTrigger,
	type Party,
} from '../config/constants';
import { ELECTORAL_STATES, EXTRA_HIT_AREA_CELLS, type ElectoralState } from '../data/electoral-map';
import {
	applyStateSpacing,
	electoralMapExtent,
	expandStateTiles,
	isLabelOverTiles,
	stateCenter,
	tallyElectoralVotes,
} from '../lib/electoral-map';
import '../styles/fonts.css';
import '../styles/tokens.css';

type Props = {
	rippleMode?: MapRippleMode;
	rippleReach?: MapRippleReach;
	rippleTrigger?: MapRippleTrigger;
};

const {
	rippleMode = MAP_RIPPLE_MODE.off,
	rippleReach = MAP_RIPPLE_REACH.map,
	rippleTrigger = MAP_RIPPLE_TRIGGER.click,
} = Astro.props;

const {
	cell,
	tileGap,
	stateSpacingTightness,
	hitAreaInset,
	bounceGrowthTarget,
	bounceScaleMin,
	bounceScaleMax,
	labelsVisible,
} = MAP_GEOMETRY;

const states = applyStateSpacing(ELECTORAL_STATES, stateSpacingTightness);
const extent = electoralMapExtent(states, labelsVisible);
const { democratCount, republicanCount } = tallyElectoralVotes(ELECTORAL_STATES);

const viewBox = [extent.left, extent.top, extent.width, extent.height]
	.map((value) => value * cell)
	.join(' ');

const summary = [
	'Electoral College map by state',
	`${CANDIDATE_NAME.democrat} ${democratCount}`,
	`${CANDIDATE_NAME.republican} ${republicanCount}`,
].join(', ');

const TILE_CLASS: Record<Party, string> = {
	[PARTY.democrat]: 'map__tile--democrat',
	[PARTY.republican]: 'map__tile--republican',
};

const tilesOf = (state: ElectoralState) =>
	expandStateTiles(state).map(({ column, row, party }) => ({
		partyClass: TILE_CLASS[party],
		x: column * cell + tileGap / 2,
		y: row * cell + tileGap / 2,
	}));

// Every state's tiles share one party, so the first tile speaks for the whole block — this is
// the assignment a click cycles away from.
const initialPartyOf = (state: ElectoralState): Party => expandStateTiles(state)[0].party;

// A state's own bounding-box span, in grid cells — how far a point at its edge sits from the
// center the bounce scale grows around.
const stateSizeOf = (state: ElectoralState): number => {
	const tiles = expandStateTiles(state);
	const columns = tiles.map(({ column }) => column);
	const rows = tiles.map(({ row }) => row);

	return Math.max(Math.max(...columns) - Math.min(...columns), Math.max(...rows) - Math.min(...rows)) + 1;
};

// Scaling every state by the same percentage made big states balloon and small ones barely
// move, since percentage growth on a bigger box is more pixels. This targets roughly the same
// absolute growth for everyone instead, clamped so tiny states don't exceed the ceiling and huge
// ones (California) don't shrink to nothing. Drives both hover and the click bounce, so the two
// stay proportionate to each other as well as to state size.
const bounceScaleOf = (state: ElectoralState): number => {
	const raw = 1 + bounceGrowthTarget / stateSizeOf(state);

	return Math.min(bounceScaleMax, Math.max(bounceScaleMin, raw));
};

// One hit-box per tile rather than one for the whole state's bounding box: a jagged, concave
// shape's bbox (California's diagonal coastline, say) can span clear across a neighboring
// state sitting in the notch. Per-tile boxes stay local, so that can't happen — every different
// -state tile pair on the map is at least 1 cell apart, well outside this padding.
//
// EXTRA_HIT_AREA_CELLS is written in ELECTORAL_STATES' raw grid coordinates, not the
// spacing-adjusted ones below — fine at the current stateSpacingTightness: 0 (identity), but
// would need its own pull applied if that ever changes.
const hitAreaTilesOf = (state: ElectoralState) => {
	const ownTiles = expandStateTiles(state).map(({ column, row }) => ({ column, row }));
	const extraCells = EXTRA_HIT_AREA_CELLS[state.id] ?? [];

	return [...ownTiles, ...extraCells].map(({ column, row }) => ({
		x: (column - hitAreaInset) * cell,
		y: (row - hitAreaInset) * cell,
		size: (1 + 2 * hitAreaInset) * cell,
	}));
};

const tileSize = cell - tileGap;
---

<figure
	class="map"
	{...{
		[DATA_ATTRIBUTE.electoralMap]: '',
		[DATA_ATTRIBUTE.rippleMode]: rippleMode,
		[DATA_ATTRIBUTE.rippleReach]: rippleReach,
		[DATA_ATTRIBUTE.rippleTrigger]: rippleTrigger,
	}}
	hidden
>
	<svg class="map__canvas" viewBox={viewBox} role="img" aria-label={summary}>
		{
			states.map((state) => {
				const initialParty = initialPartyOf(state);
				const labelOverTiles = isLabelOverTiles(state);
				const center = stateCenter(state);

				return (
					<g
						class="map__state"
						role="button"
						tabindex="0"
						aria-label={`${state.label}, ${MAP_ASSIGNMENT_LABEL[initialParty]}`}
						style={{ [CUSTOM_PROPERTY.stateHoverScale]: bounceScaleOf(state) }}
						{...{
							[DATA_ATTRIBUTE.mapState]: '',
							[DATA_ATTRIBUTE.currentParty]: initialParty,
							[DATA_ATTRIBUTE.electoralVotes]: state.electoralVotes,
							[DATA_ATTRIBUTE.labelOverTiles]: String(labelOverTiles),
							[DATA_ATTRIBUTE.centerColumn]: center.column,
							[DATA_ATTRIBUTE.centerRow]: center.row,
						}}
					>
						{/* Invisible and never scaled — this is what :hover is actually tested against.
						The visible tiles below scale on hover, which moves their edges; hover-testing
						against those directly can drop and re-trigger :hover right at an edge, on a
						jagged state, in a tight flickering loop. This sits still underneath instead. */}
						{hitAreaTilesOf(state).map((hitArea) => (
							<rect
								class="map__state-hit-area"
								x={hitArea.x}
								y={hitArea.y}
								width={hitArea.size}
								height={hitArea.size}
							/>
						))}
						{/* Holds the hover scale. Separate from .map__state-bounce below, so the click
						bounce and the sustained hover scale multiply together instead of both fighting
						over one element's transform. */}
						<g class="map__state-hover">
							<g class="map__state-bounce">
								{tilesOf(state).map((tile) => (
									<rect
										class:list={['map__tile', tile.partyClass]}
										x={tile.x}
										y={tile.y}
										width={tileSize}
										height={tileSize}
									/>
								))}
								<text
									class:list={['map__label', labelOverTiles && 'map__label--knockout']}
									x={state.labelColumn * cell}
									y={state.labelRow * cell}
									text-anchor="middle"
								>
									{state.label}
								</text>
							</g>
						</g>
					</g>
				);
			})
		}
	</svg>
</figure>

<script>
	import { initElectoralMap } from '../scripts/electoral-map-client';
	import { initElectoralMapInteraction } from '../scripts/electoral-map-interaction-client';

	initElectoralMap();
	initElectoralMapInteraction();
</script>

<style>
	.map {
		width: 100%;
		max-width: var(--bop-map-canvas-width);
		margin: 0;
	}

	.map[hidden] {
		display: none;
	}

	.map__canvas {
		display: block;
		width: 100%;
		height: auto;
		overflow: visible;
	}

	.map__state {
		cursor: pointer;
		outline: none;
	}

	.map__tile--democrat {
		fill: var(--bop-color-dem);
	}

	.map__tile--republican {
		fill: var(--bop-color-rep);
	}

	.map__tile--undecided {
		fill: var(--bop-color-tab-active-bg);
	}

	.map__label {
		font-family: var(--bop-font-family);
		font-size: var(--bop-map-label-size);
		font-weight: var(--bop-map-label-weight);
		fill: var(--bop-color-map-label);
	}

	.map__label--knockout {
		fill: var(--bop-color-page);
	}

	/* Invisible and, critically, never scaled — see the markup comment above it for why.
	   pointer-events:all keeps it hit-testable regardless of the transparent fill. */
	.map__state-hit-area {
		fill: transparent;
		pointer-events: all;
	}

	/* Hover: a transition (not the click keyframes below) so it holds at the scaled-up size for
	   as long as the cursor stays, rather than settling back to 1 mid-hover — it only eases back
	   down once the cursor actually leaves. :hover here is tested against .map__state, which
	   includes the fixed hit-area above — not against this element's own (moving) box, so scaling
	   it can never itself cause :hover to drop. Separate from the click bounce's own transform on
	   .map__state-bounce below, so a mid-hover click doesn't have both fighting to control the
	   same element's transform (which snapped visibly to the animation's own 0% keyframe,
	   ignoring wherever the hover transition currently had it).
	   The duration split below is deliberate, not an oversight: a CSS transition always uses
	   whichever rule matches the state being transitioned *into*, so growing in reads the fast
	   --bop-map-hover-duration declared on the :hover rule, while settling back down on leave
	   reads the much slower --bop-map-hover-exit-duration declared here on the base rule. */
	.map__state-hover {
		transform-box: fill-box;
		transform-origin: center;
		transition: transform var(--bop-map-hover-exit-duration) var(--bop-digit-easing);
	}

	.map__state:hover .map__state-hover {
		transform: scale(var(--bop-state-hover-scale));
		transition: transform var(--bop-map-hover-duration) var(--bop-digit-easing);
	}

	.map__state-bounce {
		transform-box: fill-box;
		transform-origin: center;
	}

	@keyframes map-state-click {
		0% {
			transform: scale(1);
		}

		45% {
			transform: scale(var(--bop-state-hover-scale));
		}

		100% {
			transform: scale(1);
		}
	}

	/* The whole state — every tile and its label — scales together as one rigid block, around
	   the group's own bounding-box center, instead of each tile popping independently. Peaks at
	   the same per-state scale hover holds at, so a click's pop and a hover's sustained grow feel
	   like the same effect rather than two differently-sized ones. Always starts and ends at
	   scale(1) on its own layer, so it composes multiplicatively with the outer group's hover
	   scale rather than overriding it. */
	.map__state[data-state-activating] .map__state-bounce {
		animation: map-state-click var(--bop-map-click-duration) var(--bop-digit-easing);
	}

	/* The ripple. The interaction script only ever publishes geometry onto a state —
	   --bop-state-ripple-distance in grid cells, plus a unit vector pointing away from the origin
	   — and everything below turns that into motion. Keeping the decay, the amplitude and the
	   wave speed here rather than in JS is what lets the reduced-motion block in tokens.css
	   switch the whole effect off by zeroing durations.

	   Every mode boils down to one pose, --ripple-pose, plus how long a state waits before
	   striking it. The click and hover triggers then reach that same pose two different ways:
	   click replays it as a keyframe pop, hover holds it with a transition. */
	.map__state {
		--ripple-strength: max(
			var(--bop-map-ripple-floor),
			1 - var(--bop-state-ripple-distance, 0) / var(--bop-map-ripple-reach)
		);
		--ripple-peak: calc(
			1 + (var(--bop-state-hover-scale) - 1) * var(--bop-map-ripple-amplitude) *
				var(--ripple-strength)
		);
		--ripple-shift-x: calc(
			var(--bop-state-ripple-direction-x, 0) * var(--bop-map-ripple-nudge) *
				var(--ripple-strength)
		);
		--ripple-shift-y: calc(
			var(--bop-state-ripple-direction-y, 0) * var(--bop-map-ripple-nudge) *
				var(--ripple-strength)
		);
		--ripple-delay: calc(var(--bop-state-ripple-distance, 0) * var(--bop-map-ripple-cell-delay));
		/* Burst deliberately drops the distance falloff — every state travels the same distance,
		   so the map opens away from the click as one piece. Reach still has to mean something
		   though, so the strength above is collapsed to a plain in-or-out gate: scaling it past 1
		   before the clamp turns any non-zero strength into 1, and only a state the reach has
		   already zeroed stays at 0. */
		--burst-gate: clamp(0, var(--ripple-strength) * 1000, 1);
		--burst-shift-x: calc(
			var(--bop-state-ripple-direction-x, 0) * var(--burst-nudge) * var(--burst-gate)
		);
		--burst-shift-y: calc(
			var(--bop-state-ripple-direction-y, 0) * var(--burst-nudge) * var(--burst-gate)
		);

		/* Filled in by the per-mode rules below. */
		--ripple-pose: none;
		--ripple-pose-opacity: 1;
	}

	/* How far a burst travels is the one thing the trigger changes about the pose itself, rather
	   than about how it's reached — see the tokens for why a held pose needs so much more of it. */
	.map {
		--burst-nudge: var(--bop-map-ripple-burst-nudge);
	}

	.map[data-ripple-trigger='hover'] {
		--burst-nudge: var(--bop-map-ripple-burst-hold-nudge);
	}

	/* A short reach with no floor under it, so states past the wave's edge sit it out entirely
	   instead of trailing off — the difference between a local jostle and a map-wide wave. */
	.map[data-ripple-reach='nearby'] {
		--bop-map-ripple-reach: 12;
		--bop-map-ripple-floor: 0;
	}

	.map[data-ripple-mode='pop'] .map__state {
		--ripple-pose: scale(var(--ripple-peak));
	}

	.map[data-ripple-mode='nudge'] .map__state {
		--ripple-pose: translate(var(--ripple-shift-x), var(--ripple-shift-y));
	}

	/* The one mode that isn't a wave: no per-distance delay and no per-distance amplitude, so
	   every state leaves at the same moment and travels the same distance, straight away from the
	   origin. The map opens up around that state rather than a front crossing it. */
	.map[data-ripple-mode='burst'] .map__state {
		--ripple-pose: translate(var(--burst-shift-x), var(--burst-shift-y));
		--ripple-delay: 0ms;
	}

	.map[data-ripple-mode='pop-nudge'] .map__state {
		--ripple-pose: translate(var(--ripple-shift-x), var(--ripple-shift-y))
			scale(var(--ripple-peak));
	}

	.map[data-ripple-mode='pop-fade'] .map__state {
		--ripple-pose: scale(var(--ripple-peak));
		--ripple-pose-opacity: calc(1 - var(--bop-map-ripple-fade) * var(--ripple-strength));
	}

	@keyframes map-state-ripple {
		0%,
		100% {
			transform: none;
			opacity: 1;
		}

		45% {
			transform: var(--ripple-pose);
			opacity: var(--ripple-pose-opacity);
		}
	}

	/* A click is a discrete event, so it plays the pose out and back as a keyframe pop, peaking
	   at 45% like the clicked state's own bounce and riding the same .map__state-bounce layer, so
	   a state caught by the wave mid-hover still composes with the outer group's hover scale.
	   animation-fill-mode:both holds the resting 0% frame through the delay — without it a state
	   waiting its turn would sit at whatever the last wave left behind and then jump. */
	.map[data-ripple-trigger='click'] .map__state[data-state-rippling] .map__state-bounce {
		animation: map-state-ripple var(--bop-map-ripple-duration) var(--bop-digit-easing)
			var(--ripple-delay) both;
	}

	/* Hover is a state, not an event, so it holds the pose for as long as the cursor stays and
	   transitions rather than replays. That distinction is the whole reason moving between states
	   is smooth: a keyframe restarted on every pointerenter cancels mid-flight and snaps the map
	   back to rest first, whereas a transition re-aims from wherever each state currently sits
	   and simply curves toward the new pose. The easing is a plain decelerate, not the springy
	   --bop-digit-easing the pop uses — overshoot on every redirect reads as wobble. */
	.map[data-ripple-trigger='hover'] .map__state-bounce {
		transition:
			transform var(--bop-map-ripple-hover-duration) var(--bop-map-ripple-hover-easing)
				var(--ripple-delay),
			opacity var(--bop-map-ripple-hover-duration) var(--bop-map-ripple-hover-easing)
				var(--ripple-delay);
	}

	.map[data-ripple-trigger='hover'] .map__state[data-state-rippling] .map__state-bounce {
		transform: var(--ripple-pose);
		opacity: var(--ripple-pose-opacity);
	}
</style>
